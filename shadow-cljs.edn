;; V2 edge build (docs/adr/0002-http-edge-live-registry-verification.md) --
;; mirrors gftdcojp/cloud-itonami's own shadow-cljs.edn :edge-api build
;; (:target :esm, one shared bundle, thin functions/api/**.js re-export
;; shims). REBUILD COMMAND: `npx shadow-cljs release edge-api` -- NOT
;; `compile` (same caveat that repo's own shadow-cljs.edn documents at
;; length: `compile`'s dev-mode artifact imports a machine-local
;; /private/tmp/cljs-runtime/... path and cannot load standalone or on a
;; Cloudflare Pages Function's runtime).
;; :dev composed alongside :cljs so shadow-cljs's OWN classpath resolution
;; picks up deps.edn's `:dev` :override-deps (pins BOTH langchain-clj maven
;; coordinates -- io.github.com-junkawasaki/langchain-clj AND io.github.
;; kotoba-lang/langchain -- to the local monorepo checkout; see that
;; alias's own deps.edn comment for the full two-coordinate reasoning).
;; Without composing :dev here, `npx shadow-cljs release edge-api` silently
;; compiles against the STALE gitlibs-pinned io.github.kotoba-lang/langchain
;; (via langgraph-clj's transitive dep), predating `kotoba-api-async` --
;; confirmed directly while adding `commitledger.edge.kotobase-store`:
;; `shadow-cljs release edge-api` emitted "WARNING: Use of undeclared Var
;; langchain.kotoba-db/kotoba-api-async" (compiles, but throws at runtime)
;; until this alias was added.
{:deps {:aliases [:dev :cljs]}
 :builds
 {:edge-api
  {:target :esm
   :output-dir "functions/edge"
   :modules {:commitment-edge-core
             {:exports {intakeOnRequestPost commitledger.edge.commitment-endpoints/on-request-post-intake
                        recordOnRequestPost commitledger.edge.commitment-endpoints/on-request-post-record
                        trancheReleaseOnRequestPost commitledger.edge.commitment-endpoints/on-request-post-tranche-release
                        approveOnRequestPost commitledger.edge.commitment-endpoints/on-request-post-approve
                        applicationOnRequestGet commitledger.edge.commitment-endpoints/on-request-get-application}}}
   :compiler-options {:output-feature-set :es2020 :infer-externs :auto}}
  :isic6492-provider
  {:target :node-script
   :output-to "dist/isic6492-provider.cjs"
   :main commitledger.edge.isic6492-provider/main
   :compiler-options {:output-feature-set :es2020 :infer-externs :auto}}
  :kotobase-provider
  {:target :node-script
   :output-to "dist/kotobase-provider.cjs"
   :main commitledger.edge.kotobase-provider/main
   :compiler-options {:output-feature-set :es2020 :infer-externs :auto}}}}

{:paths ["src"]
 ;; langgraph-clj brings langchain-clj transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace. This repo is standalone
 ;; (forkable outside the workspace); the :local/root paths only resolve
 ;; inside the monorepo checkout — a standalone fork should override them
 ;; with git coordinates. Same top-level-:deps-not-just-:dev posture as
 ;; `cloud-itonami-isic-6493`'s deps.edn, so a bare `clojure -M:test`
 ;; resolves offline inside the monorepo checkout.
 :deps {io.github.com-junkawasaki/langgraph-clj
        {:local/root "../../kotoba-lang/langgraph"}
        io.github.kotoba-lang/langchain-store
        {:local/root "../../kotoba-lang/langchain-store"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain-clj to local checkout.
  ;; TWO distinct maven coordinates resolve to this same physical repo in
  ;; this dep graph: io.github.com-junkawasaki/langchain-clj (this repo's
  ;; own + langchain-store's declared coordinate) AND io.github.kotoba-
  ;; lang/langchain (langgraph-clj's OWN declared coordinate, git-SHA-
  ;; pinned -- langgraph's deps.edn has its OWN :dev alias overriding
  ;; THAT coordinate to a local root, but a :local/root dependency's
  ;; aliases are not transitively composed by a consumer, so that
  ;; override never activates here). Without overriding BOTH
  ;; coordinates, the classpath ends up with the STALE gitlibs-pinned
  ;; io.github.kotoba-lang/langchain (via langgraph-clj) ordered BEFORE
  ;; this override's fresh local checkout, and Clojure's classloader
  ;; silently loads whichever langchain/kotoba_db.cljc it finds FIRST --
  ;; confirmed directly while adding commitledger.edge.kotobase-store
  ;; (the first code in this repo to exercise langchain.kotoba-db/
  ;; kotoba-api-async, a brand-new fn added by this same migration):
  ;; `clojure -M:dev:test` threw "No such var: kdb/kotoba-api-async"
  ;; despite the fn genuinely existing in the local checkout, because
  ;; the OLDER gitlibs-pinned copy (predating that addition) was the one
  ;; actually loaded. Overriding both coordinates to the same local root
  ;; closes this gap.
  :dev {:override-deps
        {io.github.com-junkawasaki/langchain-clj
         {:local/root "../../kotoba-lang/langchain"}
         io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  :component
  {:extra-deps {io.github.kotoba-lang/compiler
                {:git/url "https://github.com/kotoba-lang/compiler.git"
                 :git/sha "c8a9f7ef16ad8c605749e56c3bc4c73607545bec"}
                io.github.kotoba-lang/kotoba-component
                {:git/url "https://github.com/kotoba-lang/kotoba-component.git"
                 :git/sha "99275e24570265ecba91fd4026d993c135a02362"}}
   :main-opts ["-m" "kotoba.compiler.cli"]}
  ;; clojure -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "commitledger.sim"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.kotoba-lang/compiler
                      {:git/url "https://github.com/kotoba-lang/compiler.git"
                       :git/sha "c8a9f7ef16ad8c605749e56c3bc4c73607545bec"}
                      io.github.kotoba-lang/kotoba-component
                      {:git/url "https://github.com/kotoba-lang/kotoba-component.git"
                       :git/sha "99275e24570265ecba91fd4026d993c135a02362"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}
  ;; V2 (docs/adr/0002-http-edge-live-registry-verification.md): classpath for
  ;; shadow-cljs.edn's :edge-api build (`{:deps {:aliases [:cljs]}}`), same
  ;; pattern gftdcojp/cloud-itonami's own deps.edn :cljs alias uses.
  :cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                      thheller/shadow-cljs {:mvn/version "2.28.20"}}}}}
